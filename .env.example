# Copy this file to .env.local and fill it in. Never commit .env.local.

# --- AI provider -------------------------------------------------------------
# "anthropic" (Claude) or "openai" (any OpenAI-compatible API).
LLM_PROVIDER=anthropic
# Your API key. For Anthropic you can also use ANTHROPIC_API_KEY.
LLM_API_KEY=
# Optional. Defaults: claude-sonnet-5-5 (anthropic) / gpt-5-mini (openai).
LLM_MODEL=
# Only for OpenAI-compatible hosts other than OpenAI. Examples:
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:      https://api.groq.com/openai/v1
#   Cerebras:  https://api.cerebras.ai/v1
#   Ollama:    http://localhost:11434/v1   (no key needed)
LLM_BASE_URL=
# Can the model read scanned PDFs and images? auto | true | false
# auto = yes for Anthropic and OpenAI, no for other hosts.
LLM_VISION=auto

# --- Interviewer persona -----------------------------------------------------
INTERVIEWER_NAME=Riley
INTERVIEWER_ROLE=Product Designer
COMPANY_NAME=an early-stage startup

# --- Abuse and cost protection -----------------------------------------------
# Set this if you deploy publicly. Visitors must enter it to start.
ACCESS_CODE=
# Requests per visitor per minute.
RATE_LIMIT_PER_MINUTE=20
# Total AI calls per server per day (0 = unlimited). Also set a spend limit
# in your AI provider's console: that is the real safety net.
DAILY_MODEL_CALL_LIMIT=300
# Longest interviewer reply, in tokens.
MAX_OUTPUT_TOKENS=600
# Minutes before the interview skips to the wrap-up.
MAX_INTERVIEW_MINUTES=30
